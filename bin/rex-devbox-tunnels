#!/usr/bin/env python3
"""Keep local Rex connections open through configured Coder devboxes."""

import argparse
import json
import os
from pathlib import Path
import plistlib
import re
import shutil
import subprocess
import sys

PORTS = {"devbox-1": 17297, "devbox-2": 17298, "devbox-3": 17299}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("install", help="Install and start Mac login jobs")
    run = commands.add_parser("run", help="Run one tunnel in the foreground")
    run.add_argument("target", choices=sorted(PORTS))
    commands.add_parser("status", help="Show whether the Mac login jobs are loaded")
    args = parser.parse_args(argv)

    try:
        if args.command == "run":
            command = tunnel_command(args.target, configured_targets())
            os.execv(command[0], command)
        elif args.command == "install":
            install_jobs()
        else:
            print_status()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print("Rex tunnels: {}".format(error), file=sys.stderr)
        return 1

    return 0


def tunnel_command(name, targets):
    if name not in PORTS:
        raise ValueError("Unknown tunnel target: " + name)

    target = targets.get(name)

    if not target or not target.get("enabled"):
        raise ValueError("Target is not enabled in Workmate: " + name)

    workspace = target.get("coder_workspace", "")
    ssh_target = target.get("ssh_target", "")
    match = re.fullmatch(
        r"([A-Za-z0-9_-]+)\." + re.escape(workspace) + r"\.[A-Za-z0-9_-]+\.coder",
        ssh_target,
    )

    if not workspace or not match:
        raise ValueError("Cannot identify the Coder agent from Workmate target: " + name)

    coder = shutil.which("coder")

    if not coder:
        raise ValueError("coder is not on PATH")

    return [
        coder,
        "port-forward",
        workspace + "." + match.group(1),
        "--tcp",
        "127.0.0.1:{}:7297".format(PORTS[name]),
        "--disable-autostart=true",
    ]


def install_jobs():
    require_mac()
    targets = configured_targets()
    selected = [name for name in PORTS if targets.get(name, {}).get("enabled")]

    if not selected:
        raise ValueError("No Rex tunnel targets are enabled in Workmate")

    # Check every target before writing any launch jobs.
    for name in selected:
        tunnel_command(name, targets)

    jobs_dir = Path.home() / "Library/LaunchAgents"
    logs_dir = Path.home() / "Library/Logs/RexTunnels"
    jobs_dir.mkdir(parents=True, exist_ok=True)
    logs_dir.mkdir(parents=True, exist_ok=True)
    script = str(Path(__file__).resolve())
    domain = "gui/{}".format(os.getuid())

    for name in selected:
        label = job_label(name)
        path = jobs_dir / (label + ".plist")
        spec = {
            "Label": label,
            "ProgramArguments": [sys.executable, script, "run", name],
            "EnvironmentVariables": {"PATH": os.environ.get("PATH", os.defpath)},
            "RunAtLoad": True,
            "KeepAlive": True,
            "ThrottleInterval": 30,
            "StandardOutPath": str(logs_dir / (name + ".log")),
            "StandardErrorPath": str(logs_dir / (name + ".log")),
        }
        content = plistlib.dumps(spec)
        loaded = job_loaded(domain + "/" + label)
        unchanged = path.exists() and path.read_bytes() == content

        if path.exists():
            previous = plistlib.loads(path.read_bytes())
            arguments = previous.get("ProgramArguments", [])

            if len(arguments) < 2 or arguments[1] != script:
                raise ValueError("A different program owns " + str(path))

        if loaded and not unchanged:
            subprocess.run(["launchctl", "bootout", domain + "/" + label], check=True)

        path.write_bytes(content)

        if not loaded or not unchanged:
            subprocess.run(["launchctl", "bootstrap", domain, str(path)], check=True)

        print("{}: http://127.0.0.1:{}".format(name, PORTS[name]))


def print_status():
    require_mac()
    domain = "gui/{}".format(os.getuid())

    for name, port in PORTS.items():
        state = "loaded" if job_loaded(domain + "/" + job_label(name)) else "not loaded"
        print("{}: {}; http://127.0.0.1:{}".format(name, state, port))


def configured_targets():
    output = subprocess.check_output(["workmate", "--json", "devbox", "list"], text=True)
    targets = json.loads(output)

    if not isinstance(targets, list):
        raise ValueError("Unexpected Workmate target list")

    return {target["name"]: target for target in targets}


def job_label(name):
    return "com.joelseq.rex-tunnel." + name


def job_loaded(service):
    return subprocess.run(
        ["launchctl", "print", service],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def require_mac():
    if sys.platform != "darwin":
        raise ValueError("Install and status require macOS; run works on any controller")


if __name__ == "__main__":
    sys.exit(main())
