{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "tui.altScreen.lineUp": "alt+k",
  "tui.altScreen.lineDown": "alt+j",
  "tui.altScreen.halfPageUp": ["ctrl+u", "alt+shift+k"],
  "tui.altScreen.halfPageDown": ["ctrl+d", "alt+shift+j"],
  "tui.altScreen.top": ["ctrl+y", "alt+shift+h"],
  "tui.altScreen.bottom": ["ctrl+e", "alt+shift+l"]
}
